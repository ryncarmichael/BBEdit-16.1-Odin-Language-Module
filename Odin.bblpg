    },
    "CommentPrefixDefault" : "\/*"
  },
  "com.barebones.DocumentFormatVersion" : 1,
  "SampleText" : "@(private=\"file\") myFunc :: proc () {\n\n}\n",
  "Interface" : {
    "SplitViewFraction" : 0.5116063138347261
  },
  "Symbols" : {
    "FunctionPatterns" : [
      {
        "GeneratesFold" : true,
        "FunctionPattern" : "(?m)^[ \\t]*(?:@\\s*\\(\\s*private\\s*=\\s*\"[^\"]*\"\\s*\\)\\s*)?(?<function_name>[A-Za-z_]\\w*)[ \\t]*::[ \\t]*proc\\b",
        "FunctionKind" : "function"
      }
    ]
  },
  "Folding" : {
    "IntrinsicFolds" : {
